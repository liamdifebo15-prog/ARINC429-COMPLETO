# Base de datos MySQL (ajusta credenciales para tu entorno)
DATABASE_URL=mysql+pymysql://arinc_user:arinc_password@127.0.0.1:3306/arinc429

# El modo hardware se mantiene desactivado por defecto.
ARINC429_OUTPUT_ENABLED=false
ARINC429_SERIAL_PORT=/dev/ttyUSB0
ARINC429_SERIAL_BAUD=115200
AUDIO_OUTPUT_ENABLED=false
AUDIO_SAMPLE_RATE=44100
AUDIO_DURATION_SECONDS=0.25
AUDIO_MAX_AMPLITUDE=0.2
